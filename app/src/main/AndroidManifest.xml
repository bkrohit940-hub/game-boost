<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <!-- Shizuku Manager -->
        <package android:name="moe.shizuku.privileged.api" />

        <!-- PUBG Mobile Global -->
        <package android:name="com.tencent.ig" />
        <package android:name="com.vng.pubgmobile" />
        <package android:name="com.rechild.tencent.ig" />

        <!-- BGMI (India) -->
        <package android:name="com.pubg.imobile" />

        <!-- PUBG Mobile KR (Korea/Japan) -->
        <package android:name="com.pubg.krmobile" />
    </queries>

    <application
        android:name=".GameBoostApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.GameBoost">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.GameBoostService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Gaming display 120Hz lock and reversible system restore" />
        </service>

    </application>

</manifest>
