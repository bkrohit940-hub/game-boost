<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive Wireless ADB keypair credentials from Google Drive backups -->
        <exclude domain="file" path="adb_security" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="adb_security" />
    </device-transfer>
</data-extraction-rules>